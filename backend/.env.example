# Servidor
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
SERVE_FRONTEND=true

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_AUDIO_BUCKET=audios
# Limites por conta para pedidos caros (0 desliga). Contados por processo da API:
# com uma instância são um teto real; com várias, cada uma conta à parte (docs/HOSPEDAGEM.md).
RATE_LIMIT_TRANSCRIPTIONS_PER_DAY=20
RATE_LIMIT_GENERATIONS_PER_HOUR=30
RATE_LIMIT_MEDIA_PER_MINUTE=20
OAUTH_PROVIDERS=google,github

# Conversor de mídia (opcionais; npm ci instala os binários)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Provedores de IA (docs/AI_PROVIDERS.md). Vazio = comportamento legado (Hugging Face + Groq).
# Nunca há troca automática de provedor pago; fallback só quando configurado.
ASR_PROVIDER=huggingface
ASR_MODEL=
ASR_FALLBACK_PROVIDER=
ASR_LANGUAGE=pt
LLM_PROVIDER=groq
LLM_MODEL=
LLM_SUMMARY_MODEL=
LLM_QUESTIONS_MODEL=
LLM_WARNINGS_MODEL=
LLM_FLASHCARDS_MODEL=
LLM_CLEANUP_MODEL=
VISION_PROVIDER=disabled
VISION_MODEL=

# AssemblyAI (somente no servidor; nunca no navegador). Exige a migration 20261119030000.
ASSEMBLYAI_API_KEY=
# ASR_MODEL padrão com ASR_PROVIDER=assemblyai: assemblyai-stt-3-7
ASR_LANGUAGE_DETECTION=false
ASR_EXPECTED_LANGUAGES=
# Idiomas oferecidos em "Idioma da gravação" (só AssemblyAI). Vazio = os 32 idiomas do AssemblyAI-STT-3.7 (ver docs/AI_PROVIDERS.md).
# Confira a cobertura do modelo configurado e remova códigos não suportados.
ASR_SELECTABLE_LANGUAGES=
ASR_SPEAKER_LABELS=false
ASR_POLL_INTERVAL_MS=15000
ASR_MAX_WAIT_MS=10800000
# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face / Gradio ASR
HF_TOKEN=
HF_ASR_SPACE_ID=openai/whisper
HF_ASR_API_NAME=/predict
HF_ASR_AUDIO_FIELD=inputs
HF_ASR_TASK_FIELD=task
HF_ASR_TASK_VALUE=transcribe
# true quando o Space customizado devolver {text, language, segments}
HF_ASR_RETURNS_SEGMENTS=false

# Processamento
WORKER_ID=worker-local-1
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=1
# Recupera tarefas de um worker interrompido (janela em segundos, mínimo 60; 0 = desligado).
# Sem a migration de IA (20261119030000) o worker volta sozinho ao modo antigo.
WORKER_STALE_LEASE_SECONDS=600
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_1_MS=15000
JOB_RETRY_DELAY_2_MS=60000

# Desenvolvimento
MOCK_EXTERNAL_SERVICES=false

# Recursos opcionais: OFF por padrão; ativar só após conferir a migration.
# Roteiro: docs/first-integrated-test.md. Não substituem autorização.
FEATURE_CATALOG_UNITS=false
FEATURE_PLANNING=false
FEATURE_MP4_RETENTION=false
FEATURE_STUDY_TRACKING=false
FEATURE_QUIZ_V2=false
FEATURE_QUIZ_REVIEW=false
FEATURE_FLASHCARDS=false
FEATURE_SOCIAL_BASIC=false
FEATURE_SHARING=false
FEATURE_ANNOTATIONS=false
FEATURE_CALENDAR=false
# Requer database/migrations/20261119120000_study_authoring.sql aplicada.
FEATURE_STUDY_AUTHORING=false
# Requer FEATURE_FLASHCARDS e database/migrations/20261119121000_flashcard_sets.sql.
FEATURE_FLASHCARD_SETS=false
# Turmas privadas. Requer FEATURE_FLASHCARD_SETS e database/migrations/20261121140000_classrooms.sql.
FEATURE_CLASSROOMS=false
# Notes 3.0 (caderno da aula, destaques em vários trechos). Requer FEATURE_ANNOTATIONS e
# database/migrations/20261121130000_notes_3_0.sql.
FEATURE_NOTEBOOKS=false
# Limite de questoes por lista (1-100, padrao 40). Pedidos maiores sao recusados.
MAX_QUESTION_LIST_COUNT=40

