# Servidor
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
SERVE_FRONTEND=true

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_AUDIO_BUCKET=audios
OAUTH_PROVIDERS=google,github

# Conversor de mídia (opcionais; npm ci instala os binários)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Provedores de IA (docs/AI_PROVIDERS.md). Vazio = comportamento legado (Hugging Face + Groq).
# Nunca há troca automática de provedor pago; fallback só quando configurado.
ASR_PROVIDER=huggingface
ASR_MODEL=
ASR_FALLBACK_PROVIDER=
ASR_LANGUAGE=pt
LLM_PROVIDER=groq
LLM_MODEL=
LLM_SUMMARY_MODEL=
LLM_QUESTIONS_MODEL=
LLM_WARNINGS_MODEL=
LLM_FLASHCARDS_MODEL=
LLM_CLEANUP_MODEL=
VISION_PROVIDER=disabled
VISION_MODEL=

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face / Gradio ASR
HF_TOKEN=
HF_ASR_SPACE_ID=openai/whisper
HF_ASR_API_NAME=/predict
HF_ASR_AUDIO_FIELD=inputs
HF_ASR_TASK_FIELD=task
HF_ASR_TASK_VALUE=transcribe
# true quando o Space customizado devolver {text, language, segments}
HF_ASR_RETURNS_SEGMENTS=false

# Processamento
WORKER_ID=worker-local-1
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=3
JOB_RETRY_DELAY_1_MS=15000
JOB_RETRY_DELAY_2_MS=60000

# Desenvolvimento
MOCK_EXTERNAL_SERVICES=false

# Recursos opcionais: OFF por padrão; ativar só após conferir a migration.
# Roteiro: docs/first-integrated-test.md. Não substituem autorização.
FEATURE_CATALOG_UNITS=false
FEATURE_PLANNING=false
FEATURE_MP4_RETENTION=false
FEATURE_STUDY_TRACKING=false
FEATURE_QUIZ_V2=false
FEATURE_QUIZ_REVIEW=false
FEATURE_FLASHCARDS=false
FEATURE_SOCIAL_BASIC=false
FEATURE_SHARING=false
FEATURE_ANNOTATIONS=false
FEATURE_CALENDAR=false

