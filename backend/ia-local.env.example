# Copie para backend/.env.ia-local no seu computador.
# NUNCA inclua as chaves reais neste ZIP ou em arquivos versionados.
# Para esta demonstracao real nao e necessario conectar ao Supabase.
MOCK_EXTERNAL_SERVICES=false

# GroqCloud: crie NOVA chave apos revogar a exposta anteriormente.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Seu Space AudioEstudo - Whisper Large V3 com timestamps.
# Se o Space for publico, HF_TOKEN pode ficar vazio.
HF_TOKEN=
HF_ASR_SPACE_ID=cherryshere/audioestudo-asr
HF_ASR_API_NAME=/transcribe
HF_ASR_AUDIO_FIELD=inputs
HF_ASR_TASK_FIELD=task
HF_ASR_TASK_VALUE=transcribe
HF_ASR_RETURNS_SEGMENTS=true
