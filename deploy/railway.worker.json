{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci --prefix backend --omit=dev --no-audit --no-fund"
  },
  "deploy": {
    "startCommand": "npm --prefix backend run worker",
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
